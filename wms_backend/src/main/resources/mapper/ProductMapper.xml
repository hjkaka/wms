<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.wms_backend.mapper.ProductMapper">

    <!-- ===== 结果映射 ===== -->
    <resultMap id="ProductMap" type="com.example.wms_backend.entity.Product">
        <id property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="code" column="code"/>
        <result property="categoryId" column="category_id"/>
        <result property="unit" column="unit"/>
        <result property="spec" column="spec"/>
        <result property="price" column="price"/>
        <result property="warningQty" column="warning_qty"/>
        <result property="status" column="status"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <!-- ===== 公共字段 ===== -->
    <sql id="Base_Column_List">
        id, name, code, category_id, unit, spec, price, warning_qty, status, create_time, update_time
    </sql>

    <!-- ===== 根据ID查询 ===== -->
    <select id="findById" resultMap="ProductMap" parameterType="long">
        SELECT <include refid="Base_Column_List"/>
        FROM product WHERE id = #{id}
    </select>

    <!-- ===== 根据编码查询 ===== -->
    <select id="findByCode" resultMap="ProductMap" parameterType="string">
        SELECT <include refid="Base_Column_List"/>
        FROM product WHERE code = #{code}
    </select>

    <!-- ===== 查询所有（上架商品） ===== -->
    <select id="findAll" resultMap="ProductMap">
        SELECT <include refid="Base_Column_List"/>
        FROM product WHERE status = 1
        ORDER BY create_time DESC
    </select>

    <!-- ===== 条件分页查询 ===== -->
    <select id="findByCondition" resultMap="ProductMap">
        SELECT <include refid="Base_Column_List"/>
        FROM product
        <where>
            <if test="name != null and name != ''">
                AND name LIKE CONCAT('%', #{name}, '%')
            </if>
            <if test="categoryId != null">
                AND category_id = #{categoryId}
            </if>
            <if test="status != null">
                AND status = #{status}
            </if>
        </where>
        ORDER BY create_time DESC
        LIMIT #{offset}, #{pageSize}
    </select>

    <!-- ===== 统计数量 ===== -->
    <select id="countByCondition" resultType="long">
        SELECT COUNT(*)
        FROM product
        <where>
            <if test="name != null and name != ''">
                AND name LIKE CONCAT('%', #{name}, '%')
            </if>
            <if test="categoryId != null">
                AND category_id = #{categoryId}
            </if>
            <if test="status != null">
                AND status = #{status}
            </if>
        </where>
    </select>

    <!-- ===== 新增商品 ===== -->
    <insert id="insert" parameterType="com.example.wms_backend.entity.Product"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO product (name, code, category_id, unit, spec, price, warning_qty, status, create_time, update_time)
        VALUES (#{product.name}, #{product.code}, #{product.categoryId},
                #{product.unit}, #{product.spec}, #{product.price},
                #{product.warningQty}, #{product.status}, NOW(), NOW())
    </insert>

    <!-- ===== 修改商品 ===== -->
    <update id="update" parameterType="com.example.wms_backend.entity.Product">
        UPDATE product
        <set>
            <if test="product.name != null">name = #{product.name},</if>
            <if test="product.code != null">code = #{product.code},</if>
            <if test="product.categoryId != null">category_id = #{product.categoryId},</if>
            <if test="product.unit != null">unit = #{product.unit},</if>
            <if test="product.spec != null">spec = #{product.spec},</if>
            <if test="product.price != null">price = #{product.price},</if>
            <if test="product.warningQty != null">warning_qty = #{product.warningQty},</if>
            <if test="product.status != null">status = #{product.status},</if>
            update_time = NOW()
        </set>
        WHERE id = #{product.id}
    </update>

    <!-- ===== 删除商品 ===== -->
    <delete id="deleteById" parameterType="long">
        DELETE FROM product WHERE id = #{id}
    </delete>

</mapper>