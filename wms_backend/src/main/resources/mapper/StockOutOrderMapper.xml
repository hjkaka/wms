<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!-- namespace：必须和接口全类名一致，MyBatis 靠它绑定接口和 XML -->
<mapper namespace="com.example.wms_backend.mapper.StockOutOrderMapper">

    <!-- ===== 结果映射：把数据库字段名映射成 Java 属性名 =====
         property = Java 属性名，column = 数据库字段名 -->
    <resultMap id="StockOutOrderMap" type="com.example.wms_backend.entity.StockOutOrder">
        <id property="id" column="id"/>
        <result property="orderNo" column="order_no"/>
        <result property="warehouseId" column="warehouse_id"/>
        <result property="receiver" column="receiver"/>
        <result property="operatorId" column="operator_id"/>
        <result property="totalAmount" column="total_amount"/>
        <result property="status" column="status"/>
        <result property="remark" column="remark"/>
        <result property="auditTime" column="audit_time"/>
        <result property="auditorId" column="auditor_id"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <!-- ===== 公共字段 =====
         重复使用的列名抽出来，用 <include> 复用 -->
    <sql id="Base_Column_List">
        id, order_no, warehouse_id, receiver, operator_id, total_amount, status, remark,
        audit_time, auditor_id, create_time, update_time
    </sql>

    <!-- ===== 插入出库单 =====
         useGeneratedKeys + keyProperty=id：
         插入后 MySQL 自动生成的自增ID会回填到 order.getId() -->
    <insert id="insert" parameterType="com.example.wms_backend.entity.StockOutOrder"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO stock_out_order (
            order_no, warehouse_id, receiver, operator_id, total_amount, status, remark,
            audit_time, auditor_id
        ) VALUES (
            #{order.orderNo}, #{order.warehouseId}, #{order.receiver}, #{order.operatorId},
            #{order.totalAmount}, #{order.status}, #{order.remark},
            #{order.auditTime}, #{order.auditorId}
        )
    </insert>

    <!-- ===== 查询今天最大单号，用于生成唯一单号 =====
         LIKE 'CK20260821%' → 按单号倒序取最大一个 -->
    <select id="getMaxOrderNoByDate" resultType="string" parameterType="string">
        SELECT order_no FROM stock_out_order
        WHERE order_no LIKE CONCAT(#{prefix}, '%')
        ORDER BY order_no DESC
            LIMIT 1
    </select>

    <!-- ===== 根据ID查询 ===== -->
    <select id="findById" resultMap="StockOutOrderMap" parameterType="long">
        SELECT
        <include refid="Base_Column_List"/>
        FROM stock_out_order
        WHERE id = #{id}
    </select>
</mapper>