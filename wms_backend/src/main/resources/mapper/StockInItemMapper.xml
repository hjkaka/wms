<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.wms_backend.mapper.StockInItemMapper">

    <!-- ===== 结果映射 ===== -->
    <resultMap id="StockInItemMap" type="com.example.wms_backend.entity.StockInItem">
        <id property="id" column="id"/>
        <result property="orderId" column="order_id"/>
        <result property="productId" column="product_id"/>
        <result property="quantity" column="quantity"/>
        <result property="unitPrice" column="unit_price"/>
        <result property="amount" column="amount"/>
        <result property="createTime" column="create_time"/>
    </resultMap>

    <!-- ===== 批量插入 =====
         前端传过来多个明细，一次性插入
         MyBatis 支持 <foreach> 遍历插入
         collection = "items"：对应方法的参数名
         item = "item"：遍历出的每个元素叫 item
         separator = ","：每条明细之间用逗号分隔
         注意：不加 open/close，每组括号已在 foreach 内部
    -->
    <sql id="Base_Column_List">
        id, order_id, product_id, quantity, unit_price, amount, create_time
    </sql>

    <insert id="batchInsert">
        INSERT INTO stock_in_item (order_id, product_id, quantity, unit_price, amount)
        VALUES
        <!-- 每条明细生成一组括号，用逗号分隔 -->
        <foreach collection="items" item="item" separator=",">
            (#{item.orderId}, #{item.productId}, #{item.quantity}, #{item.unitPrice}, #{item.amount})
        </foreach>
    </insert>
</mapper>