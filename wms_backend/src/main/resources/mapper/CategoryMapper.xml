<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.wms_backend.mapper.CategoryMapper">

    <resultMap id="CategoryMap" type="com.example.wms_backend.entity.Category">
        <id property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="parentId" column="parent_id"/>
        <result property="sort" column="sort"/>
        <result property="status" column="status"/>
        <result property="createTime" column="create_time"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, name, parent_id, sort, status, create_time
    </sql>

    <select id="findById" resultMap="CategoryMap" parameterType="long">
        SELECT <include refid="Base_Column_List"/>
        FROM category WHERE id = #{id}
    </select>

    <select id="findAll" resultMap="CategoryMap">
        SELECT <include refid="Base_Column_List"/>
        FROM category
        ORDER BY parent_id, sort, id
    </select>

    <!-- 删除校验：该分类下有几个子分类（parent_id=该分类） -->
    <select id="countChildren" resultType="int">
        SELECT COUNT(*) FROM category WHERE parent_id = #{parentId}
    </select>

    <!-- 删除校验：该分类被几个商品引用（商品.category_id=该分类） -->
    <select id="countProductsByCategory" resultType="int">
        SELECT COUNT(*) FROM product WHERE category_id = #{categoryId}
    </select>

    <insert id="insert" parameterType="com.example.wms_backend.entity.Category"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO category (name, parent_id, sort, status, create_time)
        VALUES (#{category.name}, #{category.parentId}, #{category.sort},
                #{category.status}, NOW())
    </insert>

    <update id="update" parameterType="com.example.wms_backend.entity.Category">
        UPDATE category
        <set>
            <if test="category.name != null">name = #{category.name},</if>
            <if test="category.parentId != null">parent_id = #{category.parentId},</if>
            <if test="category.sort != null">sort = #{category.sort},</if>
        </set>
        WHERE id = #{category.id}
    </update>

    <update id="updateStatus">
        UPDATE category SET status = #{status} WHERE id = #{id}
    </update>

    <delete id="deleteById" parameterType="long">
        DELETE FROM category WHERE id = #{id}
    </delete>

</mapper>