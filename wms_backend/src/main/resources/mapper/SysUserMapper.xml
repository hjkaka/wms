<?xml version="1.0" encoding="UTF-8"?>
<!-- 第2行：DOCTYPE 声明，MyBatis 的固定写法 -->
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!-- 第3行：mapper 根标签
     namespace = 对应的 Mapper 接口的全类名
     告诉 MyBatis：这个 XML 文件和 SysUserMapper 接口是一对的
-->
<mapper namespace="com.example.wms_backend.mapper.SysUserMapper">

    <!-- ====== 通用结果映射 ======
         resultMap = 定义"数据库字段"如何映射成"Java属性"
         虽然我们开了下划线转驼峰，但写个 resultMap 更清晰、更灵活
    -->
    <resultMap id="SysUserMap" type="com.example.wms_backend.entity.SysUser">
        <id property="id" column="id"/>
        <result property="username" column="username"/>
        <result property="password" column="password"/>
        <result property="realName" column="real_name"/>
        <result property="phone" column="phone"/>
        <result property="role" column="role"/>
        <result property="status" column="status"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <!-- ====== 公共字段（写一次，到处用）====== -->
    <sql id="Base_Column_List">
        id, username, password, real_name, phone, role, status, create_time, update_time
    </sql>

    <!-- ====== 根据用户名查询用户 ======
         id = 接口里的方法名（必须完全一致！）
         resultMap = 返回结果用上面定义的 SysUserMap
         parameterType = 参数类型（String）
    -->
    <select id="findByUsername" resultMap="SysUserMap" parameterType="string">
        SELECT
        <include refid="Base_Column_List"/>
        FROM sys_user
        WHERE username = #{username}
    </select>

    <!-- ====== 根据ID查询用户 ====== -->
    <select id="findById" resultMap="SysUserMap" parameterType="long">
        SELECT
        <include refid="Base_Column_List"/>
        FROM sys_user
        WHERE id = #{id}
    </select>

    <!-- ====== 条件分页查询用户 ====== -->
    <select id="findByCondition" resultMap="SysUserMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM sys_user
        <where>
            <if test="username != null and username != ''">
                AND username LIKE CONCAT('%', #{username}, '%')
            </if>
            <if test="role != null and role != ''">
                AND role = #{role}
            </if>
            <if test="status != null">
                AND status = #{status}
            </if>
        </where>
        ORDER BY id ASC
        LIMIT #{offset}, #{pageSize}
    </select>

    <!-- ====== 统计符合条件的用户数量 ====== -->
    <select id="countByCondition" resultType="long">
        SELECT COUNT(*)
        FROM sys_user
        <where>
            <if test="username != null and username != ''">
                AND username LIKE CONCAT('%', #{username}, '%')
            </if>
            <if test="role != null and role != ''">
                AND role = #{role}
            </if>
            <if test="status != null">
                AND status = #{status}
            </if>
        </where>
    </select>

    <!-- ====== 新增用户 ====== -->
    <!-- useGeneratedKeys + keyProperty="id"：把自增主键写回 user.id（注意 password 必须先 BCrypt） -->
    <insert id="insert" parameterType="com.example.wms_backend.entity.SysUser"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO sys_user (username, password, real_name, phone, role, status, create_time, update_time)
        VALUES (#{user.username}, #{user.password}, #{user.realName},
                #{user.phone}, #{user.role}, #{user.status},
                NOW(), NOW())
    </insert>

    <!-- ====== 修改用户基本信息 ====== -->
    <!-- 密码为空串/未传则不更新；其余字段按需动态更新 -->
    <update id="update" parameterType="com.example.wms_backend.entity.SysUser">
        UPDATE sys_user
        <set>
            <if test="user.realName != null">real_name = #{user.realName},</if>
            <if test="user.phone != null">phone = #{user.phone},</if>
            <if test="user.role != null and user.role != ''">role = #{user.role},</if>
            <if test="user.password != null and user.password != ''">password = #{user.password},</if>
            update_time = NOW()
        </set>
        WHERE id = #{user.id}
    </update>

    <!-- ====== 修改用户状态（启用/停用）====== -->
    <update id="updateStatus">
        UPDATE sys_user
        SET status = #{status}, update_time = NOW()
        WHERE id = #{id}
    </update>

</mapper>